# aether-nav 生产环境变量模板
# 复制为 .env 并替换下方随机值为你自己的值，再 docker compose up 即可。
# 注意：.env 已被 .gitignore 排除，不会进入版本库；本文件为可提交模板。

# ── 必填（缺失会导致 compose 启动失败）──
# 后台管理员登录密码（请改为强密码）
ADMIN_PASSWORD=CHANGE_ME_admin_password
# Flask SECRET_KEY（会话签名，请改为随机值）
SECRET_KEY=CHANGE_ME_flask_secret_key_32_plus_chars
# JWT/Token 签名密钥（请改为随机值）
TOKEN_SECRET=CHANGE_ME_token_secret_key_32_plus_chars

# ── 可选 ──
# 浏览器跨域来源（默认 localhost:5001；经反代域名访问且跨域时改成访问地址）
CORS_ORIGINS=http://localhost:5001

# Synology 监控：DSM 多为自签证书，默认关闭 TLS 校验（true 才开启校验）
SYNO_VERIFY_SSL=false
